/**
 * Custom Styles here.
 *
 * ref：https://v1.vuepress.vuejs.org/config/#index-styl
 */

// Text links in light mode (see "Text links in light mode" below for why it is not $accentColor)
$linkColor = #b03f37

body
  font-size 18px

body,
.header-wrapper .title a,
.header-wrapper .header-right-wrap .nav .nav-item a,
.header-wrapper .header-right-wrap .search-box,
.mobile-header-bar,
#mobile-header .mobile-header-title .mobile-home-link,
.vuepress-blog-theme-content,
.ui-post-title,
.ui-post-title a,
h1, h2, h3, h4, h5, h6
  // Inter (loaded in enhanceApp.js, the same font as the social cards), then the system font while it loads
  font-family: "Inter Variable", -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", "Oxygen", "Ubuntu", "Cantarell", "Fira Sans", "Droid Sans", "Helvetica Neue", sans-serif !important

// Form controls do not inherit the page font by default (search box, theme switch, share buttons)
input,
button,
textarea
  font-family: inherit

blockquote
  font-size: 1rem
  background-color: #e9e9e9

.post-tag
  font-size: 16px
  line-height 1.7

.ui-post-summary
  font-size: 1rem !important
  line-height 1.7

.vuepress-blog-theme-content
  padding: 0 !important
  box-shadow: none !important
  font-size: 1.2rem !important

.home .hero img
  max-width: 450px !important

#header
  position: relative !important
  width: auto !important
  box-shadow: none !important

.content-wrapper
  padding-top: 30px !important

// The footer stays at the bottom of the window on short pages (a tag with one post, the 404 page).
// The theme's min-height formula assumes its own fixed header and padding, which are overridden here.
#vuepress-theme-blog__global-layout
  display: flex
  flex-direction: column
  min-height: 100vh

  > .content-wrapper
    flex: 1 0 auto
    width: 100%
    box-sizing: border-box
    min-height: 0 !important

  > .footer
    flex-shrink: 0

// Page not found (theme/layouts/NotFound.vue)
.not-found
  max-width: 740px
  margin: 0 auto
  padding: 1rem 0 2rem

  h1
    margin-top: 0

  &__actions
    display: flex
    flex-wrap: wrap
    gap: 0.6rem
    margin: 1.5rem 0 2rem

  &__button
    display: inline-flex
    align-items: center
    min-height: 44px
    padding: 0 1.2rem
    border: 1px solid $linkColor
    border-radius: 999px
    background-color: $linkColor
    color: #fff !important
    font-size: 15px
    text-decoration: none !important

    &:hover,
    &:focus-visible
      filter: brightness(1.1)

  &__button--secondary
    background-color: transparent
    color: $linkColor !important

  &__other
    margin-top: 2rem
    font-size: 15px

// Phones: the header is fixed and 79px tall (theme switch and monogram), so content starts below it
@media (max-width: 719px)
  .content-wrapper
    padding-top: 100px !important

.search-box input
  border: 0 !important
  background-color: #e9e9e9 !important

.header-wrapper .header-right-wrap .nav .nav-item a
  font-size: 16px

// "RN" monogram before the site name in the header (theme/components/Header.vue, MobileHeader.vue);
// decorative (empty alt), the name next to it is the link text
.home-link,
.mobile-home-link
  display: inline-flex !important
  align-items: center

.site-avatar
  width: 36px
  height: 36px
  margin-right: 0.6rem
  border-radius: 50%
  flex-shrink: 0

// Photo next to the greeting on the about pages (blog/README.md, blog/_en/README.md)
.about-hero
  display: flex
  align-items: center
  gap: 1.4rem
  margin: 1rem 0 1.2rem

  h1
    margin: 0 !important
    padding-top: 0 !important

  &__photo
    width: 120px
    height: 120px
    border-radius: 50%
    flex-shrink: 0

@media (max-width: 480px)
  .about-hero
    gap: 1rem

    &__photo
      width: 84px
      height: 84px

.mobile-home-link .site-avatar
  width: 30px
  height: 30px
  margin-right: 0.5rem

.hidden
  display: none !important

// Post title on phones: same place as before the content padding above grew by 30px
@media (max-width: 719px)
  .content__default:not(.custom) > h1:first-child
    padding-top: calc(5rem - 30px)

// Share block at the end of each post (components/social-share.vue)
.share-block
  margin-top: 1.5rem

  &__title
    margin: 0 0 0.8rem
    font-size: 1rem !important
    font-weight: 600

  &__buttons
    display: flex
    flex-wrap: wrap
    gap: 0.6rem

  &__status
    position: absolute
    width: 1px
    height: 1px
    overflow: hidden
    clip: rect(0 0 0 0)

.share-btn
  display: inline-flex
  align-items: center
  justify-content: center
  gap: 0.5rem
  min-height: 44px
  padding: 0 1.1rem
  border: 1px solid rgba(0, 0, 0, 0.2)
  border-radius: 999px
  background: transparent
  color: #222 !important
  font: inherit
  font-size: 15px
  line-height: 1
  text-decoration: none !important
  cursor: pointer
  transition: color 0.2s, border-color 0.2s

  &:hover,
  &:focus-visible
    color: $linkColor !important
    border-color: $linkColor

  &__icon
    width: 18px
    height: 18px
    flex-shrink: 0

  &__icon--x
    width: 16px
    height: 16px

// Previous and next post at the end of each post (theme/components/PostNav.vue): two cards side by
// side, the next one on the right; stacked on phones
.post-nav
  display: grid
  grid-template-columns: 1fr 1fr
  gap: 1rem
  margin: 2.5rem 0 1rem
  padding-top: 1.5rem
  border-top: 1px solid rgba(0, 0, 0, 0.12)

  &__link
    display: flex
    flex-direction: column
    gap: 0.35rem
    padding: 0.9rem 1.1rem
    border: 1px solid rgba(0, 0, 0, 0.15)
    border-radius: 8px
    text-decoration: none !important
    transition: border-color 0.2s

    &:hover,
    &:focus-visible
      border-color: $linkColor

  &__link--next
    grid-column: 2
    text-align: right

  &__label
    font-size: 14px
    color: rgba(0, 0, 0, 0.7)

  &__title
    font-size: 1.05rem
    font-weight: 600
    line-height: 1.4

@media (max-width: 480px)
  .post-nav
    grid-template-columns: 1fr

    &__link--next
      grid-column: 1

// Phones: buttons fill the width, two per row and the wide one below
@media (max-width: 480px)
  .share-btn
    flex: 1 1 calc(50% - 0.3rem)

  .share-btn--wide
    flex-basis: 100%

.go-to-top
  display: block !important
  right: 2rem !important

// Code blocks inherit the 1.2rem body text size; a smaller size avoids horizontal scrolling
div[class*="language-"] pre,
div[class*="language-"] pre code
  font-size: 15px !important
  line-height: 1.6 !important

// On phones the theme makes code blocks full-width with a -1.5rem margin, but the page padding
// here is 15px, so they overflowed the screen and the page scrolled sideways
@media (max-width: 419px)
  .content__default div[class*="language-"]
    margin-left: -15px !important
    margin-right: -15px !important

// Dates and tags under each post title (lists and post header): larger and darker than the theme's 12px light grey
.ui-post-meta,
.post-meta > div
  font-size: 14px !important
  line-height: 1.4 !important

.ui-post-date,
.ui-post-tag,
.ui-post-tag a
  color: rgba(0, 0, 0, 0.7) !important
  font-weight: 400 !important

// Long tag lists wrap instead of overflowing narrow screens
.ui-post-tag
  flex-wrap: wrap
  row-gap: 6px

// Text links in light mode: the brand accent (#d66056) is only 3.5:1 on the background, below the
// 4.5:1 WCAG AA minimum for text, so text uses a darker shade. The accent stays for non-text
// elements (progress bar, active page, back-to-top arrow). The `html` prefix beats the theme's
// own `a` rules without beating the header menu's black links; dark mode below overrides it.
// ($linkColor is defined at the top of this file.)

html a,
html p a code,
html .nav-link.router-link-active:not(.home-link):not(.mobile-home-link),
html .nav-link:not(.home-link):not(.mobile-home-link):hover,
html .vuepress-toc .vuepress-toc-item.active a,
html .vuepress-toc .vuepress-toc-item:hover a,
html .pagination > li > a,
html .pagination > li > span,
html .ui-post-tag a:hover,
html .feed:hover,
html .theme-toggle:hover,
html .search-box .suggestion.focused a,
html .header-wrapper .header-right-wrap .search-box .suggestions a.focused
  color: $linkColor

html .blog-tag:hover
  color: $linkColor !important
  border-color: $linkColor

// Dark mode. The theme only has a light palette (Stylus variables fixed at build time), so these
// rules override its colors. It applies when the visitor chose dark with the header switch
// (html[data-theme="dark"], see components/ThemeToggle.vue), or when their system is dark and
// they did not choose light.
$darkBg = #16181d
$darkSurface = #22252c
$darkBorder = #343842
$darkText = #d4d6db
$darkHeading = #f0f1f3
$darkMuted = rgba(255, 255, 255, 0.62)
$darkAccent = #e8786e

dark-mode()
  &
    color-scheme: dark

  &,
  body,
  #header,
  .mobile-header-bar,
  .mobile-menu-wrapper,
  .vuepress-blog-theme-content
    background-color: $darkBg !important

  body,
  p, li, td, th, em, time,
  .content__default,
  .vuepress-toc-item a,
  .reading-time
    color: $darkText !important

  h1, h2, h3, h4, h5, h6, strong,
  .ui-post-title a,
  .header-wrapper .title a,
  .header-wrapper .header-right-wrap .nav .nav-item a,
  #mobile-header .mobile-header-title .mobile-home-link,
  .nav-link,
  .blog-tag
    color: $darkHeading !important

  a,
  a em,
  a strong,
  .header-anchor,
  .nav-link.router-link-active,
  .vuepress-toc-item.active a,
  .vuepress-toc-item a:hover,
  .ui-post-title a:hover,
  .header-wrapper .header-right-wrap .nav .nav-item a:hover
    color: $darkAccent !important

  .ui-post-summary,
  .ui-post-date,
  .ui-post-tag,
  .ui-post-tag a,
  .post-meta > div,
  .latest-posts__meta
    color: $darkMuted !important

  .vuepress-toc-item
    border-left-color: $darkBorder !important

  .vuepress-toc-item.active
    border-left-color: $darkAccent !important

  blockquote
    background-color: $darkSurface !important

    p, em, a
      color: #f2b3ad !important

  // Inline code; code blocks are already dark
  p code, li code, td code
    background-color: rgba(255, 255, 255, 0.08) !important
    color: #e6c07b !important

  hr
    border-color: $darkBorder !important

  table
    tr
      background-color: $darkBg !important
      border-color: $darkBorder !important

      &:nth-child(2n)
        background-color: $darkSurface !important

    th, td
      border-color: $darkBorder !important

  .custom-block.tip,
  .custom-block.warning,
  .custom-block.danger
    background-color: $darkSurface !important

  // Tags under the post title: a chip with an arrow drawn with borders
  .post-tag a
    background-color: $darkSurface !important

    span
      color: $darkMuted !important

    &:before
      background-color: $darkBg !important

    &:after
      background-color: $darkBg !important
      border-left-color: $darkSurface !important

    &:hover
      background-color: $accentColor !important

      &:after
        border-left-color: $accentColor !important

      span
        color: #fff !important

  .blog-tag
    border-color: $darkBorder !important

  .search-box input,
  .search-box .suggestions
    background-color: $darkSurface !important
    color: $darkText !important
    border-color: $darkBorder !important

  .search-box .suggestion a
    color: $darkText !important

  .search-box .suggestion.focused
    background-color: $darkBorder !important

  .pagination > li > a,
  .pagination > li > span
    background-color: $darkSurface !important
    border-color: $darkBorder !important

  .pagination > .active > a,
  .pagination > .active > span
    background-color: $accentColor !important
    border-color: $accentColor !important
    color: #fff !important

  .pagination > .disabled > a,
  .pagination > .disabled > span
    color: $darkBorder !important

  // The black X logo of the share button
  .share-btn
    color: $darkHeading !important
    border-color: rgba(255, 255, 255, 0.25)

    &:hover,
    &:focus-visible
      color: $darkAccent !important
      border-color: $darkAccent

  .not-found__button
    background-color: $darkAccent
    border-color: $darkAccent
    color: $darkBg !important

  .not-found__button--secondary
    background-color: transparent
    color: $darkAccent !important

  .post-nav
    border-top-color: $darkBorder

  .post-nav__link
    border-color: $darkBorder

    &:hover,
    &:focus-visible
      border-color: $darkAccent

  .post-nav__label
    color: $darkMuted !important

  .footer
    background-color: #0d0e11 !important

@media (prefers-color-scheme: dark)
  html:not([data-theme="light"])
    dark-mode()

html[data-theme="dark"]
  dark-mode()

.theme-toggle
  display: inline-flex
  align-items: center
  justify-content: center
  width: 36px
  height: 36px
  margin-left: 0.4rem
  padding: 0
  border: 0
  border-radius: 50%
  background: transparent
  color: inherit
  cursor: pointer

  &:hover
    color: $accentColor

  svg
    width: 20px
    height: 20px

#mobile-header .theme-toggle
  margin-left: auto
  margin-right: 0.8rem